&CONTROL
    calculation = 'scf'
    restart_mode = 'from_scratch'
    pseudo_dir = '/home/software/materia/pseudo'
    outdir = '/home/STUDENTI/leonardo.razzai/WORK'
    prefix = Ni_bulk
    disk_io = 'nowf'
/
&SYSTEM
    ibrav = 2
    celldm(1) = 6.9
    nat = 1
    ntyp = 1
    ecutwfc = 30
    ecutrho = 240
    nspin = 2
    starting_magnetization(1) = 0.01
    occupations = 'smearing'
    smearing = 'gaussian'
    degauss = 0.02
/
&ELECTRONS
    diagonalization = 'david'
    electron_maxstep = 200
    mixing_mode = 'plain'
    mixing_beta = 0.40
    conv_thr = 1.0d-6
/

ATOMIC_SPECIES
Rh      102.905    rh_pbe_v1.4.uspp.F.UPF 

ATOMIC_POSITIONS angstrom
Rh   0.00   0.00   0.00 

K_POINTS automatic
14 14 14 0 0 0
