&CONTROL
    calculation = 'relax'
    restart_mode = 'from_scratch'
    pseudo_dir = '/home/STUDENTI/enrico.pedretti/pseudo/'
    outdir = '/home/STUDENTI/leonardo.razzai/Rh_work/CO2'
    max_seconds = 1200
    tstress=.true.
/
&SYSTEM
    ibrav = 1
    a = 30.
    nat = 3
    ntyp = 2
    ecutwfc = 35.0
    ecutrho = 280.0
 /
&ELECTRONS
    diagonalization = 'david'
    electron_maxstep = 200
    mixing_mode = 'plain'
    mixing_beta = 0.6
    conv_thr = 1.0d-8
/
&IONS
    ion_dynamics = 'bfgs'
/

ATOMIC_SPECIES
O  15.9990 O.pbe-n-rrkjus_psl.1.0.0.UPF   
C  12.0112 C.pbe-n-rrkjus_psl.1.0.0.UPF

ATOMIC_POSITIONS angstrom
C  0.0   0.0  0.0
O -1.16  0.0  0.0
O  1.16  0.0  0.0

K_POINTS gamma


